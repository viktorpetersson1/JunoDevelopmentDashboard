# Supabase project: mbehvcfiakjznzqkymse (see DECISIONS.md D-001)
NEXT_PUBLIC_SUPABASE_URL=https://mbehvcfiakjznzqkymse.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to client. Used in migrations + audit-log inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Direct DB connection for Drizzle migrations (transaction pooler, port 6543)
# Get from Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=

# Sentry (T076, optional in dev)
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags (T011 /api/config · V7 T134 surface parking)
# Comma-separated. Default (empty) = the 4-surface exec dashboard; adding a
# flag re-enables that parked surface intact (reachable by URL again).
# Flags: pricing · analytics-lab (sensitivity/stress/scenarios/modeler/risks/
# waterfall) · earnings · notifications · suggestions-page · users · activity ·
# cleanup · pipeline-capacity · project-wizard
# e.g. ATLAS_FEATURE_FLAGS=pricing,analytics-lab
ATLAS_FEATURE_FLAGS=

# ── V6.1.5 — Pricing engine → Perplexity Sonar ──────────────────────────────
# Perplexity Sonar API key. Set in the Cloudflare Pages dashboard ONLY — never
# commit a real key. Read by lib/llm/perplexity-client.ts (hard error if missing
# when the Sonar path is active).
PERPLEXITY_API_KEY=
# Optional endpoint override (default https://api.perplexity.ai/chat/completions).
# Set only if the live smoke returns 404 on the default path.
PERPLEXITY_API_URL=
# Provider flag (D-073, feature-flag option b). 'anthropic' (default) keeps the
# live pricing path on Anthropic; 'perplexity' flips it to Sonar (T-PRC-3 flip).
PRICING_LLM_PROVIDER=
# Optional comma-separated Sonar comp-search domain allow-list (Gate 2). Default
# is zillow,redfin,compass,douglaselliman,corcoran,saunders (set in code).
PRICING_COMP_DOMAINS=
